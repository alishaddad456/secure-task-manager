# Local Docker Compose settings only. Never use these credentials in production.
POSTGRES_DB=taskmanager
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=local_dev_password

# Local Docker Compose PostgreSQL connection.
DATABASE_URL=postgresql+psycopg://taskmanager:local_dev_password@db:5432/taskmanager

# For local SQLite development, use:
# DATABASE_URL=sqlite:///./tasks.db
